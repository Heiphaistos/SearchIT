# Copier en .env puis compléter. Chaque marchand s'active dès que ses variables sont définies.

PORT=8787
HOST=0.0.0.0

# auto = catalogue de démonstration seulement si aucune source réelle n'est configurée ; on | off
DEMO_MODE=auto

# Domaines autorisés à appeler l'API depuis un navigateur (le configurateur de PC).
# Vide = tous. Exemple : https://config.heiphaistos.org,https://searchit.heiphaistos.org
CORS_ORIGINS=

# Clés exigées sur /api/v1/* (en-tête x-api-key), séparées par des virgules. Vide = accès libre.
API_KEYS=

# Adresse publique (plan du site, liens de partage)
PUBLIC_URL=https://searchit.heiphaistos.org
# Recherches autorisées par minute et par IP (0 = illimité) – protège les crédits Google Shopping
RATE_LIMIT_PER_MINUTE=60
# Derrière Caddy/nginx : lire l'IP réelle du visiteur (false si SearchIT est exposé directement)
TRUST_PROXY=true
# Tableau de bord /admin : jeton secret (générer avec `openssl rand -hex 24`). Vide = désactivé.
ADMIN_TOKEN=
# Historique des prix (fichier JSON), « off » pour désactiver
HISTORY_FILE=.cache/history.json

SEARCH_TIMEOUT_MS=8000
CACHE_TTL_SECONDS=600
FEED_REFRESH_MINUTES=360

# ---------- Google Shopping (source n°1 : tous les marchands français en une clé) ----------
# Un seul fournisseur suffit ; les suivants servent de secours quand le quota est atteint.
# Serper.dev : 2 500 requêtes offertes – https://serper.dev
SERPER_API_KEY=
SERPER_DAILY_LIMIT=80
# SearchApi.io : 100 requêtes offertes – https://www.searchapi.io
SEARCHAPI_API_KEY=
SEARCHAPI_DAILY_LIMIT=3
# SerpApi : offre gratuite mensuelle – https://serpapi.com
SERPAPI_API_KEY=
SERPAPI_DAILY_LIMIT=3
# Durée de conservation des résultats (économise les crédits)
GOOGLE_SHOPPING_CACHE_HOURS=24
GOOGLE_SHOPPING_COUNTRY=fr
GOOGLE_SHOPPING_LANGUAGE=fr

# ---------- Sources sans clé ----------
# Boutiques Shopify / WooCommerce (catalogue public) : domaine|Nom|refurb, séparés par des virgules
SHOPIFY_STORES=
WOOCOMMERCE_STORES=
# Liste de boutiques publiques fournie (server/config/public-stores.json) : on | off
PUBLIC_STORES=on
# Fiches techniques Open Icecat (compte gratuit facultatif, « openIcecat-live » par défaut)
ICECAT_USERNAME=

# ---------- API officielles ----------

# Amazon Product Advertising API 5.0 (Partenaires Amazon : https://partenaires.amazon.fr)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.fr

# eBay Browse API (https://developer.ebay.com) – EBAY_CAMPAIGN_ID = eBay Partner Network (liens affiliés)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_CAMPAIGN_ID=

# AliExpress Open Platform – API Affiliate (https://openservice.aliexpress.com)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# ---------- Flux produits d'affiliation (Awin, Effinity, Kwanko, programme du marchand…) ----------
# URL http(s) ou chemin de fichier ; CSV, XML Google Merchant ou JSON, gzip accepté.
# Optionnel : FEED_<ID>_FORMAT=csv|xml|json, FEED_<ID>_KEEP_ALL=true (ne pas filtrer le non high-tech)
FEED_BACKMARKET_URL=
FEED_FNAC_URL=
FEED_LDLC_URL=
FEED_LECLERC_URL=
FEED_CDISCOUNT_URL=
FEED_RAKUTEN_URL=
FEED_BOULANGER_URL=
FEED_DARTY_URL=
FEED_MATERIELNET_URL=
FEED_TOPACHAT_URL=
FEED_RUEDUCOMMERCE_URL=
FEED_GROSBILL_URL=
FEED_VISIODIRECT_URL=
FEED_1FOTRADE_URL=
FEED_CERTIDEAL_URL=
FEED_REFURBED_URL=
